@echo off
rem AgentHub executor daemon wrapper for Windows. Task Scheduler's plain CLI
rem doesn't expose systemd/launchd-style "restart on exit" semantics, so this
rem loop plays that role directly — restart the node process if it ever exits,
rem same effect as Restart=always / KeepAlive, no extra service-wrapper tool
rem needed. Generated by deploy/setup-node.ps1 with the real paths filled in.
rem The scheduled task starts outside the installer PowerShell, so explicitly
rem preserve every runtime directory the bootstrap discovered or installed.
set "PATH=__RUNTIME_PATH__;%PATH%"
:loop
"__NODE__" "__SCRIPT__" >> "__LOG__" 2>&1
ping -n 6 127.0.0.1 >nul
goto loop
