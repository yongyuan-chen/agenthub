{
  // AgentHub worker: API + Hub DO + static frontend, one deploy unit.
  "name": "agenthub",
  "main": "src/index.mjs",
  "compatibility_date": "2026-06-01",
  // Required by the agents SDK: parts of it (observability, the email helper's
  // mimetext dependency) import node: built-ins. Additive — it only makes Node
  // APIs available, it doesn't change existing Hub/D1 behaviour.
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "agenthub.win", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Assets matching a request are otherwise served without ever invoking
    // the Worker — and index.mjs has to fill this site's origin into the
    // installers so `curl -fsSL <site>/install.sh | bash` needs no APP_URL.
    // Once this is a list, anything NOT on it is asset-first, and the SPA
    // fallback answers every unknown path with index.html — so every route
    // index.mjs handles has to be listed, not just the installers.
    "run_worker_first": ["/api/*", "/ws/*", "/supervisor", "/supervisor/*", "/install.sh", "/install.ps1"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      // One instance per user, named by user id (see index.mjs's /supervisor
      // route). Holds that user's supervisor chat history, auto-approval
      // setting and audit log in its own SQLite storage.
      { "name": "SUPERVISOR", "class_name": "SupervisorAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    { "tag": "v2", "new_sqlite_classes": ["SupervisorAgent"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agenthub",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],
  "observability": { "enabled": true }
}
